<title>VIDALDOCS | Prépare tes concours</title>

<style>
:root {
  --bg: #080a0d;
  --surface: #11151b;
  --surface2: #171d25;
  --gold: #f5c451;
  --gold2: #ffe29a;
  --white: #f8fafc;
  --muted: #a3acb9;
  --green: #20c76a;
  --border: rgba(255,255,255,.09);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--bg);
  color: var(--white);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button, input, select {
  font: inherit;
}

button, a {
  -webkit-tap-highlight-color: transparent;
}

.container {
  width: min(1120px, 92%);
  margin: auto;
}

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(8,10,13,.96);
  border-bottom: 1px solid var(--border);
}

.navbar {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.logo {
  font-size: 25px;
  font-weight: 900;
  letter-spacing: -1px;
}

.logo span {
  color: var(--gold);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 25px;
  color: var(--muted);
  font-size: 14px;
}

.nav-links a:hover {
  color: var(--gold);
}

.nav-cta {
  background: var(--gold);
  color: #15110a;
  padding: 11px 17px;
  border-radius: 9px;
  font-weight: 800;
  font-size: 13px;
}

.hero {
  padding: 88px 0 70px;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(245,196,81,.15), transparent 55%),
    var(--bg);
  text-align: center;
}

.tag {
  display: inline-block;
  border: 1px solid rgba(245,196,81,.35);
  background: rgba(245,196,81,.08);
  color: var(--gold2);
  border-radius: 50px;
  padding: 7px 15px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
  margin-bottom: 23px;
}

.hero h1 {
  max-width: 850px;
  margin: 0 auto 22px;
  font-size: clamp(37px, 7vw, 72px);
  line-height: 1.06;
  letter-spacing: -2px;
  font-weight: 900;
}

.hero h1 span {
  color: var(--gold);
}

.hero-text {
  max-width: 620px;
  margin: auto;
  color: var(--muted);
  font-size: 17px;
}

.hero-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  min-height: 50px;
  padding: 14px 21px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 800;
  transition: transform .2s, opacity .2s;
  cursor: pointer;
  border: none;
}

.btn:hover {
  transform: translateY(-2px);
  opacity: .92;
}

.btn-gold {
  background: var(--gold);
  color: #171208;
}

.btn-outline {
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--white);
}

.btn-green {
  background: var(--green);
  color: #06160b;
}

.hero-note {
  color: #7f8997;
  font-size: 12px;
  margin-top: 18px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 42px;
}

.stat {
  padding: 20px 10px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,.025);
  border-radius: 14px;
}

.stat strong {
  display: block;
  color: var(--gold);
  font-size: 20px;
}

.stat span {
  color: var(--muted);
  font-size: 12px;
}

section {
  padding: 75px 0;
  scroll-margin-top: 85px;
}

.section-head {
  max-width: 650px;
  margin: 0 auto 38px;
  text-align: center;
}

.eyebrow {
  color: var(--gold);
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 12px;
}

.section-head h2 {
  font-size: clamp(28px, 5vw, 42px);
  line-height: 1.2;
  margin-bottom: 14px;
  letter-spacing: -1px;
}

.section-head p {
  color: var(--muted);
  font-size: 15px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.card {
  background: linear-gradient(145deg, var(--surface2), var(--surface));
  border: 1px solid var(--border);
  border-radius: 17px;
  padding: 25px;
  transition: border-color .2s, transform .2s;
}

.card:hover {
  border-color: rgba(245,196,81,.4);
  transform: translateY(-3px);
}

.card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 13px;
  background: rgba(245,196,81,.1);
  color: var(--gold);
  font-size: 23px;
  margin-bottom: 19px;
}

.card h3 {
  font-size: 18px;
  margin-bottom: 10px;
}

.card p {
  color: var(--muted);
  font-size: 14px;
}

.card-link {
  display: inline-block;
  color: var(--gold);
  font-size: 13px;
  font-weight: 800;
  margin-top: 18px;
}

.pack-section {
  background: #0c0f13;
}

.pack-layout {
  display: grid;
  grid-template-columns: 1fr .9fr;
  gap: 30px;
  align-items: center;
}

.pack-copy h2 {
  font-size: clamp(29px, 5vw, 44px);
  line-height: 1.15;
  margin-bottom: 18px;
}

.pack-copy > p {
  color: var(--muted);
  margin-bottom: 25px;
}

.feature-list {
  list-style: none;
}

.feature-list li {
  padding: 11px 0;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
}

.feature-list li::before {
  content: "+ ";
  color: var(--gold);
  font-weight: 900;
  margin-right: 8px;
}

.price-card {
  border: 1px solid rgba(245,196,81,.35);
  border-radius: 22px;
  padding: 30px;
  background:
    radial-gradient(circle at top right, rgba(245,196,81,.13), transparent 55%),
    var(--surface);
}

.price-label {
  color: var(--muted);
  font-size: 13px;
}

.price {
  font-size: clamp(39px, 6vw, 54px);
  color: var(--gold);
  font-weight: 900;
  letter-spacing: -2px;
  line-height: 1.25;
  margin: 8px 0;
}

.price small {
  font-size: 15px;
  letter-spacing: 0;
}

.old-price {
  color: #7b8491;
  font-size: 14px;
  text-decoration: line-through;
}

.price-description {
  color: var(--muted);
  font-size: 13px;
  margin: 17px 0;
}

.price-card .btn {
  width: 100%;
  margin-top: 11px;
}

.disclaimer {
  color: #8d97a5;
  font-size: 11px;
  text-align: center;
  margin-top: 16px;
}

.steps {
  counter-reset: steps;
}

.step {
  position: relative;
  padding-left: 65px;
  margin-bottom: 25px;
}

.step::before {
  counter-increment: steps;
  content: counter(steps, decimal-leading-zero);
  position: absolute;
  left: 0;
  top: 0;
  width: 46px;
  height: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245,196,81,.1);
  color: var(--gold);
  border: 1px solid rgba(245,196,81,.25);
  border-radius: 12px;
  font-weight: 900;
}

.step h3 {
  font-size: 16px;
  margin-bottom: 5px;
}

.step p {
  color: var(--muted);
  font-size: 14px;
}

.faq-list {
  max-width: 780px;
  margin: auto;
}

details {
  padding: 20px;
  margin-bottom: 12px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: var(--surface);
}

summary {
  cursor: pointer;
  font-size: 15px;
  font-weight: 800;
}

details p {
  padding-top: 14px;
  color: var(--muted);
  font-size: 14px;
}

.contact-box {
  text-align: center;
  padding: 40px 25px;
  border: 1px solid rgba(245,196,81,.25);
  background: radial-gradient(ellipse at top, rgba(245,196,81,.1), transparent 75%), var(--surface);
  border-radius: 22px;
}

.contact-box h2 {
  font-size: clamp(27px, 5vw, 40px);
  margin-bottom: 12px;
}

.contact-box p {
  max-width: 550px;
  margin: 0 auto 24px;
  color: var(--muted);
  font-size: 14px;
}

footer {
  border-top: 1px solid var(--border);
  padding: 30px 0;
  color: var(--muted);
  font-size: 12px;
  text-align: center;
}

.footer-logo {
  font-size: 20px;
  font-weight: 900;
  color: var(--white);
  margin-bottom: 8px;
}

.footer-logo span {
  color: var(--gold);
}

.footer-links {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 18px;
  margin: 15px 0;
}

.footer-links a:hover {
  color: var(--gold);
}

.mobile-bar {
  display: none;
}

@media (max-width: 760px) {
  .navbar {
    min-height: 66px;
  }

  .logo {
    font-size: 22px;
  }

  .nav-links {
    display: none;
  }

  .hero {
    padding: 65px 0 48px;
  }

  .hero h1 {
    letter-spacing: -1.5px;
  }

  .hero-text {
    font-size: 15px;
  }

  .hero-actions {
    flex-direction: column;
  }

  .hero-actions .btn {
    width: 100%;
  }

  .stats {
    gap: 8px;
  }

  .stat {
    padding: 14px 5px;
  }

  .stat strong {
    font-size: 17px;
  }

  .stat span {
    font-size: 10px;
  }

  section {
    padding: 55px 0;
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .card {
    padding: 23px;
  }

  .pack-layout {
    grid-template-columns: 1fr;
  }

  .price-card {
    padding: 25px;
  }

  .mobile-bar {
    display: block;
    position: fixed;
    z-index: 90;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 10px 4%;
    background: rgba(8,10,13,.97);
    border-top: 1px solid var(--border);
  }

  .mobile-bar .btn {
    width: 100%;
    min-height: 46px;
  }

  footer {
    padding-bottom: 85px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *, *::before, *::after {
    transition: none !important;
  }
}
</style>
</head>

